<Window x:Class="Kes.Gui.DeveloperPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="1:1 目标预览"
        Width="1500"
        Height="950"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#FF071018"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        AutomationProperties.AutomationId="DeveloperLargePreviewWindow">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#FF101923"
                BorderBrush="#1FFFFFFF"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            Background="#220067C0"
                            CornerRadius="7">
                        <iconPacks:PackIconLucide Kind="Scan"
                                   Style="{StaticResource IconText}"
                                   Foreground="{StaticResource AccentBrush}" Width="15" Height="15" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="1:1 目标预览"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding DeveloperPreviewTargetText}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="#A8FFFFFF"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#1FFFFFFF"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="14,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeveloperFrameInfoText}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#D8FFFFFF" />
                </Border>

                <Button Grid.Column="2"
                        Style="{StaticResource BaseButton}"
                        Padding="12,6"
                        Click="CloseButton_Click"
                        AutomationProperties.AutomationId="DeveloperLargePreviewCloseButton">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="X"
                                   Style="{StaticResource IconText}" Width="13" Height="13"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="关闭" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PreviewScrollViewer"
                      Grid.Row="1"
                      Grid.Column="0"
                      Background="#FF071018"
                      Padding="16"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="LargePreviewSurface"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="#FF0D1620"
                  MouseMove="PreviewSurface_MouseMove"
                  MouseLeave="PreviewSurface_MouseLeave"
                  MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                  MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp"
                  MouseRightButtonDown="PreviewSurface_MouseRightButtonDown">
                <Image x:Name="LargePreviewImage"
                       Source="{Binding DeveloperPreviewImage}"
                       Stretch="Fill"
                       SnapsToDevicePixels="True"
                       AutomationProperties.AutomationId="DeveloperLargePreviewImage"
                       AutomationProperties.Name="1:1 截图画面"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />

                <Rectangle x:Name="LargeGridOverlay"
                           IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile"
                                      Viewport="0,0,40,40"
                                      ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="Transparent">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,40,40" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#2A4F687D" Thickness="1" />
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                                                <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border Width="1"
                        Background="#55FFFFFF"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False" />
                <Border Height="1"
                        Background="#55FFFFFF"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />

                <Canvas x:Name="MatchCandidatesCanvas"
                        IsHitTestVisible="False"
                        AutomationProperties.AutomationId="DeveloperLargePreviewMatchCandidates" />

                <Canvas x:Name="OcrBoxCanvas"
                        IsHitTestVisible="False"
                        AutomationProperties.AutomationId="DeveloperLargePreviewOcrBoxes" />

                <Canvas x:Name="LargeOverlayCanvas"
                        IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionRectangle"
                               Stroke="#FF00D5FF"
                               StrokeThickness="2"
                               Fill="#2600D5FF"
                               Visibility="Collapsed" />
                    <Rectangle x:Name="MatchRectangle"
                               Stroke="#FFFFB020"
                               StrokeThickness="2"
                               Fill="#20FFB020"
                               Visibility="Collapsed" />
                    <Line x:Name="CursorVerticalLine"
                          Stroke="#E600D5FF"
                          StrokeThickness="1"
                          Visibility="Collapsed" />
                    <Line x:Name="CursorHorizontalLine"
                          Stroke="#E600D5FF"
                          StrokeThickness="1"
                          Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#FF0B131C"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <TextBlock Text="标注"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="在图片上按住鼠标左键拖出区域；右键清除。"
                               Style="{StaticResource CaptionText}"
                               Foreground="#90FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,10" />
                    <TextBlock x:Name="SelectionInfoText"
                               AutomationProperties.AutomationId="DeveloperLargePreviewSelectionInfo"
                               Text="未选择区域"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#6FDBFF"
                               Margin="0,0,0,10" />
                    <Border Height="88"
                            Background="#FF071018"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,10"
                            ClipToBounds="True">
                        <Image x:Name="CropPreviewImage"
                               Stretch="Uniform"
                               AutomationProperties.AutomationId="DeveloperLargePreviewCropPreview"
                               AutomationProperties.Name="裁切预览" />
                    </Border>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Button Content="裁切保存"
                                Style="{StaticResource BaseButton}"
                                Margin="0,0,5,0"
                                Click="SaveCropButton_Click"
                                AutomationProperties.AutomationId="DeveloperLargePreviewSaveCropButton" />
                        <Button Content="清除选区"
                                Style="{StaticResource BaseButton}"
                                Margin="5,0,0,0"
                                Click="ClearSelectionButton_Click"
                                AutomationProperties.AutomationId="DeveloperLargePreviewClearSelectionButton" />
                    </UniformGrid>

                    <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,14" />

                    <TextBlock Text="判断样本"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="选择当前画面类型，生成原图、标注图、OCR 明细和建议 ROI；不修改任务配置。"
                               Style="{StaticResource CaptionText}"
                               Foreground="#90FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,10" />
                    <ComboBox x:Name="SnapshotPageTypeBox"
                              DisplayMemberPath="PageLabel"
                              SelectedIndex="0"
                              MinHeight="32"
                              Margin="0,0,0,8"
                              AutomationProperties.AutomationId="DeveloperLargePreviewSnapshotPageType" />
                    <Button Content="OCR 并生成标注样本"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Click="CaptureDecisionSnapshotButton_Click"
                            AutomationProperties.AutomationId="DeveloperLargePreviewSnapshotButton" />
                    <TextBlock x:Name="DecisionSnapshotStatusText"
                               AutomationProperties.AutomationId="DeveloperLargePreviewSnapshotStatus"
                               Text="等待生成样本"
                               Style="{StaticResource CaptionText}"
                               Foreground="#90FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,8,0,16" />

                    <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,14" />

                    <TextBlock Text="OCR"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock x:Name="ModelStatusText"
                               AutomationProperties.AutomationId="DeveloperLargePreviewModelStatus"
                               Text="正在检查 PP-OCRv5 模型..."
                               Style="{StaticResource CaptionText}"
                               Foreground="#90FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,10" />
                    <Button Content="OCR 识别选区"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Click="OcrSelectionButton_Click"
                            AutomationProperties.AutomationId="DeveloperLargePreviewOcrButton" />
                    <TextBlock x:Name="OcrStatusText"
                               AutomationProperties.AutomationId="DeveloperLargePreviewOcrStatus"
                               Text="等待识别"
                               Style="{StaticResource CaptionText}"
                               Foreground="#90FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,8,0,6" />
                    <TextBox x:Name="OcrResultText"
                             AutomationProperties.AutomationId="DeveloperLargePreviewOcrResult"
                             Text=""
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="100"
                             MaxHeight="170"
                             Style="{StaticResource FluentTextBox}"
                             Margin="0,0,0,16" />

                    <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,14" />

                    <TextBlock Text="图片查找"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="当前使用 OpenCV 多尺度模板匹配；把选区当作模板，在完整截图中查找多个候选位置。"
                               Style="{StaticResource CaptionText}"
                               Foreground="#90FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="匹配阈值"
                                   Foreground="#C8FFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="MatchThresholdBox"
                                 AutomationProperties.AutomationId="DeveloperLargePreviewMatchThreshold"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Text="0.80"
                                 Style="{StaticResource FluentTextBox}"
                                 HorizontalContentAlignment="Right"
                                 Margin="6,0,12,0" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="结果数"
                                   Foreground="#C8FFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="MatchMaximumResultsBox"
                                 AutomationProperties.AutomationId="DeveloperLargePreviewMatchMaximumResults"
                                 Grid.Row="0"
                                 Grid.Column="3"
                                 Text="20"
                                 Style="{StaticResource FluentTextBox}"
                                 HorizontalContentAlignment="Right"
                                 Margin="6,0,0,0" />

                        <TextBlock Grid.Row="2"
                                   Text="最小缩放"
                                   Foreground="#C8FFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="MatchMinimumScaleBox"
                                 AutomationProperties.AutomationId="DeveloperLargePreviewMatchMinimumScale"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="0.80"
                                 Style="{StaticResource FluentTextBox}"
                                 HorizontalContentAlignment="Right"
                                 Margin="6,0,12,0" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="最大缩放"
                                   Foreground="#C8FFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="MatchMaximumScaleBox"
                                 AutomationProperties.AutomationId="DeveloperLargePreviewMatchMaximumScale"
                                 Grid.Row="2"
                                 Grid.Column="3"
                                 Text="1.20"
                                 Style="{StaticResource FluentTextBox}"
                                 HorizontalContentAlignment="Right"
                                 Margin="6,0,0,0" />

                        <TextBlock Grid.Row="4"
                                   Text="缩放步长"
                                   Foreground="#C8FFFFFF"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="MatchScaleStepBox"
                                 AutomationProperties.AutomationId="DeveloperLargePreviewMatchScaleStep"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Text="0.05"
                                 Style="{StaticResource FluentTextBox}"
                                 HorizontalContentAlignment="Right"
                                 Margin="6,0,12,0" />
                    </Grid>
                    <Button Content="查找选区图像"
                            Style="{StaticResource BaseButton}"
                            HorizontalAlignment="Stretch"
                            Click="FindSelectionButton_Click"
                            AutomationProperties.AutomationId="DeveloperLargePreviewFindButton" />                    
                    <TextBlock x:Name="MatchStatusText"
                               AutomationProperties.AutomationId="DeveloperLargePreviewMatchStatus"
                               Text="等待查找"
                               Style="{StaticResource CaptionText}"
                               Foreground="#90FFFFFF"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="#FF101923"
                BorderBrush="#1FFFFFFF"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="像素"
                           Foreground="#88FFFFFF"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DeveloperPointerTargetText}"
                           FontFamily="Consolas"
                           FontWeight="SemiBold"
                           Foreground="#6FDBFF"
                           Margin="8,0,24,0"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="相对"
                           Foreground="#88FFFFFF"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{Binding DeveloperPointerRelativeText}"
                           FontFamily="Consolas"
                           FontWeight="SemiBold"
                           Foreground="#6FDBFF"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />

                <Border Grid.Column="4"
                        Background="#180067C0"
                        CornerRadius="5"
                        Padding="9,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="100% · 游戏像素尺寸"
                               FontSize="11"
                               Foreground="#9EDBFF" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>