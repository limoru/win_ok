<Window x:Class="Kes.Gui.Views.ChaosModeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        xmlns:views="clr-namespace:Kes.Gui.Views"
        Title="自动卡厄思模式设置"
        Width="980"
        Height="840"
        MinWidth="860"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="自动卡厄思模式"
                       Style="{StaticResource PageTitleText}" />
            <TextBlock Text="保存独立配置方案后，可在外面的会话任务方案中分配给不同窗口。"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,0" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="已保存方案"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <ComboBox Grid.Column="1"
                          Height="34"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name" />
                <Button Grid.Column="2"
                        Style="{StaticResource BaseButton}"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding HasSelectedProfile}"
                        Command="{Binding DeleteProfileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Trash2"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="删除方案" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="3"
                           Text="{Binding SaveStatusText}"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="方案名称"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBox Grid.Column="1"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2"
                        Content="保存方案"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Command="{Binding SaveProfileCommand}" />
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="干员头像"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AvatarCountText}"
                               Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding AvatarPreviews}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="48"
                                    Height="48"
                                    Margin="0,0,6,0"
                                    CornerRadius="5"
                                    Background="#12000000"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    ToolTip="{Binding Label}">
                                <Grid>
                                    <Image Source="{Binding Preview}"
                                           Stretch="UniformToFill" />
                                    <Button Width="17"
                                            Height="17"
                                            MinWidth="0"
                                            Padding="0"
                                            Margin="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#D8FFFFFF"
                                            BorderBrush="{StaticResource ControlBorderBrush}"
                                            Command="{Binding DataContext.RemoveAvatarCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="删除头像">
                                        <iconPacks:PackIconLucide Kind="X"
                                                                  Width="10"
                                                                  Height="10" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2"
                        Style="{StaticResource SubtleButton}"
                        Height="32"
                        MinWidth="86"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding CanAddAvatar}"
                        Click="AddAvatarButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ImagePlus"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="添加头像"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2"
                Style="{StaticResource FluentCard}"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <views:ChaosModeSettingsView DataContext="{Binding Settings}" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="关闭"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
