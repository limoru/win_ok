<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Automation.Core\Automation.Core.csproj" />
    <ProjectReference Include="..\Automation.Targets.Windows\Automation.Targets.Windows.csproj" />
    <ProjectReference Include="..\Automation.Vision.Onnx\Automation.Vision.Onnx.csproj" />
    <ProjectReference Include="..\Kes.Tasks\Kes.Tasks.csproj" />
    <ProjectReference Include="..\Kes.Layout.WindowsPc\Kes.Layout.WindowsPc.csproj" />
    <ProjectReference Include="..\Kes.Layout.AndroidMobile\Kes.Layout.AndroidMobile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Use the dotnet host in this environment; the .NET 9 apphost hits a CET fail-fast on the current Windows build. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
