<Window x:Class="Kes.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Kes.Gui.Views"
        mc:Ignorable="d"
        Title="Kes Automation"
        Width="1380"
        Height="880"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#EDF3F9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="18,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28"
                                Height="28"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="7">
                            <TextBlock Text="K"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="9,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Kes Automation"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Windows PC runtime"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MonitorStatusText}"
                                   Style="{StaticResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="520"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0" />

                        <Border Grid.Column="1"
                                Height="28"
                                Margin="0,0,12,0"
                                Padding="10,0"
                                Background="#B8FFFFFF"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding SessionCount, StringFormat=会话 {0}}"
                                           Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button
                                    ToolTip="最小化"
                                    Style="{StaticResource WindowButton}"
                                    Click="MinimizeButton_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" >
<iconPacks:PackIconLucide Kind="Minus" Width="12" Height="12" />
</Button>
                            <Button
                                    ToolTip="最大化或还原"
                                    Style="{StaticResource WindowButton}"
                                    Click="MaximizeButton_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" >
<iconPacks:PackIconLucide Kind="Maximize" Width="12" Height="12" />
</Button>
                            <Button
                                    ToolTip="关闭"
                                    Style="{StaticResource CloseWindowButton}"
                                    Click="CloseButton_Click"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" >
<iconPacks:PackIconLucide Kind="X" Width="12" Height="12" />
</Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource NavigationBrush}"
                        BorderBrush="#12000000"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="8,10,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Button Content="捕获"
                                          Tag="{x:Static iconPacks:PackIconLucideKind.Crosshair}"
                                          Style="{StaticResource NavigationButton}"
                                          IsDefault="{Binding IsCapturePage}"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="0"
                                          AutomationProperties.AutomationId="NavCapture" />
                            <Button Content="任务"
                                          Tag="{x:Static iconPacks:PackIconLucideKind.ListChecks}"
                                          Style="{StaticResource NavigationButton}"
                                          IsDefault="{Binding IsTasksPage}"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="1"
                                          AutomationProperties.AutomationId="NavTasks" />
                            <Button Content="日志"
                                          Tag="{x:Static iconPacks:PackIconLucideKind.ScrollText}"
                                          Style="{StaticResource NavigationButton}"
                                          IsDefault="{Binding IsLogsPage}"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="2"
                                          AutomationProperties.AutomationId="NavLogs" />
                            <Button Content="开发测试"
                                          Tag="{x:Static iconPacks:PackIconLucideKind.FlaskConical}"
                                          Style="{StaticResource NavigationButton}"
                                          IsDefault="{Binding IsDeveloperPage}"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="3"
                                          AutomationProperties.AutomationId="NavDeveloper" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Border Height="1" Background="#12000000" Margin="10,8,10,8" />
                            <Button Content="设置"
                                          Tag="{x:Static iconPacks:PackIconLucideKind.Settings}"
                                          Style="{StaticResource NavigationButton}"
                                          IsDefault="{Binding IsSettingsPage}"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="4"
                                          AutomationProperties.AutomationId="NavSettings" />
                            <Button Content="关于"
                                          Tag="{x:Static iconPacks:PackIconLucideKind.Info}"
                                          Style="{StaticResource NavigationButton}"
                                          IsDefault="{Binding IsAboutPage}"
                                          Command="{Binding NavigateCommand}"
                                          CommandParameter="5"
                                          AutomationProperties.AutomationId="NavAbout" />
                            <Border Margin="8,10,8,0"
                                    Padding="12"
                                    Background="#86FFFFFF"
                                    BorderBrush="#10000000"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            Background="#180067C0"
                                            CornerRadius="6">
                                        <TextBlock Text="WIN"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Windows PC"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TargetCount, StringFormat={}{0} 个受支持目标}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid Visibility="{Binding IsCapturePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="348" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource FluentCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42"
                                                Height="42"
                                                Background="#180067C0"
                                                CornerRadius="10"
                                                VerticalAlignment="Center">
                                            <iconPacks:PackIconLucide Kind="Crosshair"
                                                       Style="{StaticResource IconText}" Width="20" Height="20"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,18,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Cardes Automation"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="PC 版 / 模拟器 · 持续存在性监视 · v0.1"
                                                       Style="{StaticResource SecondaryText}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource StatusPill}"
                                                Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconLucide Kind="Monitor"
                                                           Style="{StaticResource IconText}" Width="16" Height="16"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding MonitorStatusText}"
                                                           MaxWidth="280"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Command="{Binding RefreshTargetsCommand}"
                                                    Style="{StaticResource BaseButton}"
                                                    AutomationProperties.AutomationId="CheckTargetsButton">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="RefreshCw" Style="{StaticResource IconText}" Width="14" Height="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="立即检查" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ExportDiagnosticsCommand}"
                                                    Style="{StaticResource BaseButton}"
                                                    AutomationProperties.AutomationId="ExportDiagnosticsButton">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="FileDown" Style="{StaticResource IconText}" Width="14" Height="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="导出诊断" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding StartAllCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Margin="0"
                                                    AutomationProperties.AutomationId="StartAllButton">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="Play" Style="{StaticResource IconText}" Width="14" Height="14" Foreground="White" Margin="0,0,7,0" />
                                                    <TextBlock Text="全部启动" Foreground="White" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="0.85*" />
                                    </Grid.ColumnDefinitions>

                                    <HeaderedContentControl Grid.Column="0"
                                                            Header="运行目标"
                                                            Style="{StaticResource CardControl}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <UniformGrid Grid.Row="0" Columns="3">
                                                <Button Content="全部"
                                                        Style="{StaticResource ProfileButton}"
                                                        Margin="0,0,4,0"
                                                        IsDefault="{Binding IsAllTargetProfile}"
                                                        Command="{Binding SelectTargetProfileCommand}"
                                                        CommandParameter="All"
                                                        AutomationProperties.AutomationId="TargetProfileAll" />
                                                <Button Content="PC 版"
                                                        Style="{StaticResource ProfileButton}"
                                                        Margin="0,0,6,0"
                                                        IsDefault="{Binding IsPcTargetProfile}"
                                                        Command="{Binding SelectTargetProfileCommand}"
                                                        CommandParameter="PC"
                                                        AutomationProperties.AutomationId="TargetProfilePc" />
                                                <Button Content="模拟器"
                                                        Style="{StaticResource ProfileButton}"
                                                        Margin="6,0,0,0"
                                                        IsDefault="{Binding IsEmulatorTargetProfile}"
                                                        Command="{Binding SelectTargetProfileCommand}"
                                                        CommandParameter="Emulator"
                                                        AutomationProperties.AutomationId="TargetProfileEmulator" />
                                            </UniformGrid>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="PC 版"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PcTargetStatusText}"
                                                               Margin="7,0,0,0"
                                                               Style="{StaticResource CaptionText}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="模拟器"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding EmulatorTargetStatusText}"
                                                               Margin="7,0,0,0"
                                                               Style="{StaticResource CaptionText}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="4">
                                                <TextBox x:Name="TargetSearchBox"
                                                         Text="{Binding TargetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource FluentTextBox}"
                                                         AutomationProperties.AutomationId="TargetSearchBox" />
                                                <TextBlock Text="搜索实例或进程"
                                                           Margin="11,0,0,0"
                                                           Foreground="#7A7A7A"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=TargetSearchBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Grid.Row="6">
                                                <ListBox ItemsSource="{Binding FilteredTargets}"
                                                         SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                                         Style="{StaticResource FluentListBox}"
                                                         ItemContainerStyle="{StaticResource FluentListBoxItem}"
                                                         AutomationProperties.AutomationId="TargetList">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="36" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="30"
                                                                        Height="30"
                                                                        Background="#140067C0"
                                                                        CornerRadius="6"
                                                                        VerticalAlignment="Center">
                                                                    <iconPacks:PackIconLucide Kind="Crosshair"
                                                                               Style="{StaticResource IconText}" Width="15" Height="15"
                                                                               Foreground="{StaticResource AccentBrush}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="9,0,8,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Summary}"
                                                                               Style="{StaticResource CaptionText}"
                                                                               Margin="0,3,0,0"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2"
                                                                        Padding="7,2"
                                                                        Background="#120067C0"
                                                                        CornerRadius="4"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StateLabel}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource AccentBrush}" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding HasNoFilteredTargets, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="未检测到当前档位目标"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding MonitorStatusText}"
                                                               Style="{StaticResource CaptionText}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FilteredTargetCount, StringFormat={}{0} 个目标}"
                                                               Style="{StaticResource CaptionText}" />
                                                    <TextBlock Text=" · "
                                                               Style="{StaticResource CaptionText}" />
                                                    <TextBlock Text="{Binding LastTargetCheckText}"
                                                               Style="{StaticResource CaptionText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </HeaderedContentControl>

                                    <HeaderedContentControl Grid.Column="2"
                                                            Header="当前活动"
                                                            Style="{StaticResource CardControl}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Border Padding="8,3"
                                                        Background="{StaticResource AccentSoftBrush}"
                                                        CornerRadius="5"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding SelectedSession.ActivityStatusLabel, TargetNullValue=空闲, FallbackValue=空闲}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding SelectedSession.SessionId, TargetNullValue=暂无会话, FallbackValue=暂无会话}"
                                                           Style="{StaticResource CaptionText}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="当前任务" Style="{StaticResource CaptionText}" />
                                                <TextBlock Text="{Binding SelectedSession.CurrentActivityTitle, TargetNullValue=等待任务, FallbackValue=等待任务}"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="4">
                                                <TextBlock Text="当前步骤" Style="{StaticResource CaptionText}" />
                                                <TextBlock Text="{Binding SelectedSession.CurrentActivityStep, TargetNullValue=尚未连接任务运行时, FallbackValue=尚未连接任务运行时}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Row="6"
                                                       Text="{Binding SelectedSession.CurrentActivityDetail, TargetNullValue=添加并启动一个会话后，这里会显示游戏内正在执行的操作。, FallbackValue=添加并启动一个会话后，这里会显示游戏内正在执行的操作。}"
                                                       Style="{StaticResource SecondaryText}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="52" />

                                            <Border Grid.Row="8"
                                                    Padding="12,8"
                                                    Background="#0C000000"
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="刷取进度" Style="{StaticResource CaptionText}" />
                                                        <TextBlock Text="{Binding SelectedSession.ActivityProgressText, TargetNullValue=-, FallbackValue=-}"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                    <ProgressBar Grid.Column="1"
                                                                 Width="112"
                                                                 Height="6"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding SelectedSession.ActivityProgressValue, Mode=OneWay, TargetNullValue=0, FallbackValue=0}"
                                                                 Background="#18000000"
                                                                 Foreground="{StaticResource AccentBrush}"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <TextBlock Grid.Row="10"
                                                       Text="{Binding SelectedSession.ActivityUpdatedText, StringFormat=更新于 {0}, TargetNullValue=更新于 --:--:--, FallbackValue=更新于 --:--:--}"
                                                       Style="{StaticResource CaptionText}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </HeaderedContentControl>
                                </Grid>
                                <Border Grid.Row="4" Style="{StaticResource FluentCard}" Padding="12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding ExportDiagnosticsCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="FileDown" Style="{StaticResource IconText}" Width="14" Height="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="导出日志" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding OpenDiagnosticsFolderCommand}"
                                                    Style="{StaticResource BaseButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="FolderOpen" Style="{StaticResource IconText}" Width="14" Height="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="诊断目录" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding NavigateCommand}"
                                                    CommandParameter="2"
                                                    Style="{StaticResource BaseButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="ScrollText" Style="{StaticResource IconText}" Width="14" Height="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="查看日志" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="覆盖层"
                                                       Style="{StaticResource SecondaryText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <ToggleButton IsChecked="True"
                                                          Style="{StaticResource SwitchToggle}"
                                                          ToolTip="切换运行覆盖层" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <Grid Visibility="{Binding IsTasksPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock Text="任务" Style="{StaticResource PageTitleText}" />
                                        <TextBlock Text="查看任务目录，并管理已绑定会话的运行状态。"
                                                   Style="{StaticResource SecondaryText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding StartAllCommand}"
                                                Style="{StaticResource PrimaryButton}">
